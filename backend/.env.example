# ── Qdrant Cloud (required) ─────────────────────────────────
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=papersense_v2_dev

# ── App ─────────────────────────────────────────────────────
DEBUG=false
CORS_ORIGINS=http://localhost:3000

# ── Parsing ─────────────────────────────────────────────────
# off | auto | on
OCR_MODE=off
# off | local | gemini
FORMULA_MODE=local
DOCLING_THREADS=4

# ── Embeddings (changing the model needs a new QDRANT_COLLECTION) ──
DENSE_MODEL=BAAI/bge-base-en-v1.5

# ── Optional ────────────────────────────────────────────────
HF_TOKEN=
